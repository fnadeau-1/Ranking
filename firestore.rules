rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // A "ranker" is anyone with a rankers/{uid} doc. The first ranker must be
    // created by hand in the Firebase console (see README) — after that, existing
    // rankers can promote others from the Rank Dashboard.
    function isRanker() {
      return request.auth != null
        && exists(/databases/$(database)/documents/rankers/$(request.auth.uid));
    }

    // An optional string field: either absent, or a string within maxLen. Used
    // for the customizable roster fields (grade/record/hometown/notes) so a
    // wrestler doc can carry them but isn't required to.
    function okOptStr(data, field, maxLen) {
      return !data.keys().hasAny([field])
        || (data[field] is string && data[field].size() <= maxLen);
    }

    // -------------------------------------------------------------------------
    // Wrestler roster — managed exclusively by rankers.
    // -------------------------------------------------------------------------
    match /wrestlers/{wrestlerId} {
      allow read: if true;

      allow create: if isRanker()
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 100
        && request.resource.data.school is string
        && request.resource.data.school.size() <= 100
        && request.resource.data.weightClass is string
        && request.resource.data.weightClass.size() <= 20
        && okOptStr(request.resource.data, 'grade', 20)
        && okOptStr(request.resource.data, 'record', 20)
        && okOptStr(request.resource.data, 'hometown', 100)
        && okOptStr(request.resource.data, 'notes', 300)
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.createdAt == request.time
        && request.resource.data.keys().hasOnly([
            'name', 'school', 'weightClass',
            'grade', 'record', 'hometown', 'notes',
            'createdBy', 'createdAt'
        ]);

      allow update: if isRanker()
        && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['name', 'school', 'weightClass',
                      'grade', 'record', 'hometown', 'notes'])
        && okOptStr(request.resource.data, 'grade', 20)
        && okOptStr(request.resource.data, 'record', 20)
        && okOptStr(request.resource.data, 'hometown', 100)
        && okOptStr(request.resource.data, 'notes', 300);

      allow delete: if isRanker();
    }

    // -------------------------------------------------------------------------
    // Weeks — the ranker creates one per ranking cycle.
    // -------------------------------------------------------------------------
    match /weeks/{weekId} {
      allow read: if true;

      allow create: if isRanker()
        && request.resource.data.label is string
        && request.resource.data.label.size() > 0
        && request.resource.data.label.size() <= 60
        && request.resource.data.startDate is timestamp
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.createdAt == request.time
        && request.resource.data.keys().hasOnly([
            'label', 'startDate', 'createdBy', 'createdAt'
        ]);

      allow update, delete: if isRanker();
    }

    // -------------------------------------------------------------------------
    // Ranking lists — one per week + weight class, holding the ordered
    // wrestler-id array the ranker builds via drag-and-drop. Unpublished
    // (draft) lists are only visible to rankers; the public only ever sees
    // published lists. Client queries for the public MUST filter
    // where('published','==',true) for this rule to allow the list read.
    // -------------------------------------------------------------------------
    match /rankingLists/{listId} {
      allow read: if resource.data.published == true || isRanker();

      allow create: if isRanker()
        && request.resource.data.weekId is string
        && request.resource.data.weightClass is string
        && request.resource.data.weightClass.size() > 0
        && request.resource.data.weightClass.size() <= 20
        && request.resource.data.order is list
        && request.resource.data.published is bool
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.keys().hasOnly([
            'weekId', 'weightClass', 'order', 'published',
            'createdAt', 'updatedAt', 'updatedBy'
        ]);

      // Update pins the immutable provenance fields (weekId/weightClass/
      // createdAt) so a published list can't be silently repointed to a
      // different week or weight class, and limits edits to the mutable
      // set (order/published/updatedAt/updatedBy). createdBy is not part of
      // this collection's schema, so it is not referenced here.
      allow update: if isRanker()
        && request.resource.data.weekId == resource.data.weekId
        && request.resource.data.weightClass == resource.data.weightClass
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.order is list
        && request.resource.data.published is bool
        && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['order', 'published', 'updatedAt', 'updatedBy']);

      allow delete: if isRanker();
    }

    // -------------------------------------------------------------------------
    // Votes — written ONLY by the castVote Cloud Function (Admin SDK, which
    // bypasses these rules entirely). Direct client writes are denied so the
    // per-user rate limit and the "list must be published" check in that
    // function can't be skipped by a modified client. Counts are public.
    // -------------------------------------------------------------------------
    match /votes/{voteId} {
      allow read: if true;
      allow write: if false;
    }

    // -------------------------------------------------------------------------
    // Comments — written ONLY by the postComment Cloud Function, for the same
    // reason as votes: rate limiting and length/email-verification checks are
    // only trustworthy if the client can't write around them.
    // -------------------------------------------------------------------------
    match /comments/{commentId} {
      allow read: if true;
      allow create, update: if false;
      allow delete: if request.auth != null
        && (resource.data.userId == request.auth.uid || isRanker());
    }

    // -------------------------------------------------------------------------
    // Rankers — the first doc is bootstrapped by hand in the console; existing
    // rankers can add or remove others from the Rank Dashboard.
    // -------------------------------------------------------------------------
    match /rankers/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;

      allow create, update: if isRanker()
        && request.resource.data.addedBy == request.auth.uid
        && request.resource.data.addedAt == request.time
        && request.resource.data.keys().hasOnly(['addedAt', 'addedBy']);

      allow delete: if isRanker();
    }

    // -------------------------------------------------------------------------
    // User rankings — a fan's own reordering of a published list, written ONLY
    // by the submitUserRanking Cloud Function (Admin SDK). Direct client writes
    // are denied so the "must be a permutation of the published order" check and
    // the rate limit in that function can't be skipped by a modified client.
    // Reads are public so anyone can compute the aggregated People's Ranking.
    // -------------------------------------------------------------------------
    match /userRankings/{rankingId} {
      allow read: if true;
      allow write: if false;
    }

    // -------------------------------------------------------------------------
    // Rate-limit counters for votes/comments — Admin SDK only (Cloud Functions).
    // No client rule matches "read" or "write" here, so both are denied by
    // Firestore's default-deny; this block exists just to document that.
    // -------------------------------------------------------------------------
    match /rateLimits/{uid} {
      allow read, write: if false;
    }

    // -------------------------------------------------------------------------
    // Per-week, per-user comment counters that back the "10 comments per week's
    // ranking" cap — written only by the postComment Cloud Function (Admin SDK).
    // Denied to all clients so the cap can't be reset or forged.
    // -------------------------------------------------------------------------
    match /commentCounts/{id} {
      allow read, write: if false;
    }
  }
}
